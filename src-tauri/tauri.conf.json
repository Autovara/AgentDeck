{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentDeck",
  "version": "0.1.0-alpha.1",
  "identifier": "io.agentdeck.alpha",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentDeck",
        "width": 1024,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "visible": true,
        "fullscreen": false,
        "maximized": false,
        "transparent": false,
        "alwaysOnTop": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: ipc: https://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Local attention board for AI coding agents.",
    "longDescription": "AgentDeck is a local-first dashboard, tray app, and Telegram bot that tracks running AI coding agents (Claude Code, Codex CLI, Aider), surfaces sessions that need a human, and lets you safely stop or mute them remotely. Pre-alpha software; lead validation platform is Linux. macOS and Windows builds arrive at beta.",
    "homepage": "https://github.com/anthropics/agentdeck",
    "publisher": "AgentDeck contributors",
    "copyright": "Copyright (c) AgentDeck contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "devel",
        "priority": "optional"
      }
    }
  },
  "plugins": {}
}
