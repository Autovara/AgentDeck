# Node / frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/
.npm/

# Build outputs
dist/
build/
out/
.next/
.turbo/
.cache/

# Rust / Tauri
target/
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/

# Tauri signing material — never commit
*.key
*.p12
src-tauri/.tauri/
src-tauri/tauri.conf.local.json

# Local runtime SQLite databases (the app stores its real DB under the per-OS
# app data directory; these patterns catch stray dev/test copies in the repo).
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Environment files
.env
.env.*
!.env.example

# Editor / OS files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# Logs
*.log
logs/

# Coverage / test artifacts
coverage/
.nyc_output/
*.lcov

# Local fixture captures (real recordings are committed under fixtures/sessions/;
# this catches scratch captures kept outside that directory).
*.cap
*.recording

# Private planning and design docs. These live locally for the maintainers but
# must never be published to the public repository.
/planning/
